# FPL Gaffer runtime config.
# Copy to .env (gitignored) on each machine that runs the pipeline and fill in:
#   cp .env.example .env      # then edit .env
# .env is never committed — Mac (dev) and Pi each keep their own copy.

# Your FPL team's entry ID: the number in fantasy.premierleague.com/api/entry/<ID>/
# (public data, but kept out of the tree so the repo can go public without it).
# Consumed at invocation, e.g.:
#   python3 fpl_api.py fetch --entry "$FPL_ENTRY_ID" --out data
FPL_ENTRY_ID=YOUR_ENTRY_ID

# Real secrets land here too once those pieces exist (see security ticket #10):
# Telegram bot token, LLM API key, FPL session cookie. Never commit them.
# TELEGRAM_BOT_TOKEN=
# LLM_API_KEY=
# FPL_SESSION_COOKIE=

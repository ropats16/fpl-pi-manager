[Unit]
Description=FPL Gaffer pull (main -> pi/live) + self-test-gated reload
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gaffer
WorkingDirectory=/opt/fpl-gaffer
# Allowlist (the deploy notice's target chats) + non-secret config.
EnvironmentFile=-/etc/fpl-gaffer/gaffer.env
# Telegram token for the deploy notice — same encrypted-cred mechanism as the
# daemon, decrypted into a service-private tmpfs. The deploy path never loads the
# LLM key (least privilege — see daemon.config.load_notify_config). (#10 §3)
LoadCredentialEncrypted=telegram-token:/etc/credstore.encrypted/telegram-token
# Pull main -> pi/live, then (only if tracked *.py changed) gate a daemon restart
# behind the offline selftest and push a Telegram deploy/blocked notice. The
# daemon never runs git itself (git stays out of the tier-1 core, #11 §3); this
# oneshot owns the pull and, via the narrow sudoers grant, the restart.
ExecStart=/opt/fpl-gaffer/deploy/pull-reload.sh

# Non-secret daemon config. Install as /etc/fpl-gaffer/gaffer.env (root-owned,
# 0644), OUTSIDE the repo/workspace so a poisoned gaffer cannot widen its own
# allowlist (#10 §2). Real secrets do NOT go here — they are systemd-creds
# encrypted (see deploy/README.md).

# Numeric Telegram user IDs allowed to talk to the gaffer (comma/space list).
# NEVER @username. Get yours by messaging the bot and reading the daemon's
# "drop" log line, or via @userinfobot.
GAFFER_ALLOWLIST_USER_IDS=000000000

# OpenRouter model slug for the default workhorse (#8: Kimi K2.5). Override to
# escalate. Confirm the exact current slug on openrouter.ai/models.
GAFFER_MODEL=moonshotai/kimi-k2.5
# The gaffer's per-call output budget (tokens). Reasoning models (Sol) spend
# hidden reasoning out of it first — 1024 returned an EMPTY six-report draft on
# 2026-09-04. 8k ≈ ≤$0.08 a call at Sol prices; the journal's llm_call
# finish_reason=length shows a cut-off.
#GAFFER_MAX_TOKENS=8192

# FPL entry (team) id — the public, non-secret numeric id in your FPL team URL
# (fantasy.premierleague.com/entry/<THIS>/event/1). The post-GW review (#21)
# needs it to pull the picks you actually fielded for the settled gameweek.
# Safe to commit / share (it is not a credential). Left blank the review falls
# back to the season-state squad (no autosubs applied).
FPL_ENTRY_ID=

# --- Gaffer chat tools — the chat tool-loop ceilings (spec §3, tier-1) ----------
# When chat tools are wired the gaffer answers as a bounded run_agent loop; these
# are its circuit breakers (turns / wall-clock minutes / est. USD per chat).
#GAFFER_CHAT_MAX_TURNS=12
#GAFFER_CHAT_MAX_MINUTES=6
#GAFFER_CHAT_MAX_COST_USD=0.40

# --- Engineer build jobs — the on-Pi build loop ceilings (spec §4, tier-1) ------
# `build #N` spawns `daemon build N`, which clones origin/main and runs a bounded
# run_agent loop that reads/edits only inside data/work/build-N/ and opens a PR
# (green as a normal PR, red as a draft). These are its circuit breakers; FIX_TURNS
# is how many times it may fix after a red `run_tests` before it is told to stop.
#GAFFER_BUILD_MAX_TURNS=40
#GAFFER_BUILD_MAX_MINUTES=25
#GAFFER_BUILD_MAX_COST_USD=0.60
#GAFFER_BUILD_FIX_TURNS=2
# The engineer's model (a per-role override like the analysts'); defaults to the
# flash GAFFER_HELPER_MODEL. It is NOT run by the weekly fan-out.
#GAFFER_HELPER_MODEL_ENGINEER=z-ai/glm-5.3-flash

# --- Helper runtime (#54) — all optional; defaults are the #51 decisions -------
# Model for the analysts + Scout (+ the search sub-call) and for the AM. The
# gaffer itself stays on GAFFER_MODEL.
#GAFFER_HELPER_MODEL=z-ai/glm-5.3-flash
#GAFFER_AM_MODEL=qwen/qwen3.8-max
# One role on a different model (availability/fixtures/quality/market/chips/scout/am):
#GAFFER_HELPER_MODEL_MARKET=z-ai/glm-5.3-flash
# Fetch domain allowlist (bare domains, subdomains match; REPLACES the seed list:
# fantasy.premierleague.com fantasyfootballscout.co.uk understat.com
# football-data.co.uk api.the-odds-api.com). Tier-1: only Rohit edits this.
#GAFFER_FETCH_ALLOWLIST=fantasy.premierleague.com,fantasyfootballscout.co.uk,understat.com,football-data.co.uk,api.the-odds-api.com
# Per-helper ceilings — circuit breakers ~3x above a thorough run; raise on
# cap_hit evidence from the post-GW review, never silently.
#GAFFER_HELPER_MAX_FETCHES=25
#GAFFER_HELPER_MAX_SEARCHES=15
#GAFFER_HELPER_MAX_TURNS=40
#GAFFER_HELPER_MAX_MINUTES=15
# Per-wake rails (#56): read from the LLM's running totals between helper
# steps; a crossed rail stubs the remaining helpers, the draft still sends.
#GAFFER_WAKE_MAX_CALLS=200
#GAFFER_WAKE_MAX_TOKENS=5000000
#GAFFER_WAKE_MAX_USD=1.0
#GAFFER_WAKE_MAX_MINUTES=90
# Month-to-date ledger (#56, data/spend-ledger.json): at SEARCH_OFF helpers
# lose `search`, at HELPERS_OFF analysts + Scout are skipped (gaffer + AM run).
#GAFFER_LEDGER_SEARCH_OFF_USD=4.0
#GAFFER_LEDGER_HELPERS_OFF_USD=4.75
# Price table (USD per 1M tokens) used for the estimated cost on every llm_call
# event; JSON, extends the built-in table (sol / glm-5.3-flash / qwen3.8-max).
#GAFFER_PRICE_TABLE={"moonshotai/kimi-k2.5": {"prompt": 0.6, "completion": 2.5}}
# The Odds API key is NOT set here: it is the encrypted `odds-api-key`
# credential (deploy/README.md), appended by the fetcher for its host only.
# Likewise the GitHub token (#55 auto-PR) is the encrypted `github-token`
# credential. Only the PR target repo is config:
#GAFFER_GITHUB_REPO=ropats16/fpl-pi-manager

# Where the math pipeline scripts live (the refresh insists data dir == repo root/data);
# a dev/test seam — leave unset on the Pi.
#GAFFER_REPO_ROOT=/opt/fpl-gaffer
